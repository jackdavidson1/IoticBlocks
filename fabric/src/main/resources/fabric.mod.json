{
  "schemaVersion": 1,
  "id": "ioticblocks",
  "version": "${mod_version}",
  "name": "IoticBlocks",
  "description": "A port of HexGloop's block read/write patterns for 1.20 and beyond.",
  "authors": [
    "object-Object"
  ],
  "contact": {
    "homepage": "https://object-object.github.io/IoticBlocks",
    "sources": "https://github.com/object-Object/IoticBlocks"
  },
  "license": "MIT",
  "icon": "assets/ioticblocks/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [{
      "adapter": "kotlin",
      "value": "gay.object.ioticblocks.fabric.FabricIoticBlocks"
    }],
    "client": [{
      "adapter": "kotlin",
      "value": "gay.object.ioticblocks.fabric.FabricIoticBlocksClient"
    }]
  },
  "mixins": [
    "ioticblocks-common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "architectury": ">=13.0.8",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${flk_version}"
  },
  "suggests": {
    "another-mod": "*"
  }
}
